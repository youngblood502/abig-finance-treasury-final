# The automated tests' own disposable PostgreSQL 18 server. Do not copy this by hand: `npm run testdb:init` creates the server and writes .env.test
# with a newly generated password. The tests read only .env.test, refuse any other host, port, user or database, and never read .env.
TEST_ADMIN_URL=postgresql://abig_test_admin:GENERATED_BY_TESTDB_INIT@127.0.0.1:55432/postgres
