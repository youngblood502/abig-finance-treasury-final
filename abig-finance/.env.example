# Local development. Copy to .env.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/abig
DATABASE_URL=postgresql://abig_app:app_pw_change_me_1@localhost:5432/abig
AUTH_DATABASE_URL=postgresql://abig_auth:auth_pw_change_me_1@localhost:5432/abig
WORKER_DATABASE_URL=postgresql://abig_worker:worker_pw_change_me_1@localhost:5432/abig
# Used by `npm run migrate` to give the three roles their passwords (16+ characters):
APP_DB_PASSWORD=app_pw_change_me_1
AUTH_DB_PASSWORD=auth_pw_change_me_1
WORKER_DB_PASSWORD=worker_pw_change_me_1
STORAGE_DIR=./.storage
APP_URL=http://localhost:3000
# Development only. Lets you skip signing in; remove it to try the real sign-in screen.
DEV_USER_ID=a0000000-0000-4000-8000-000000000002
# Tests (a superuser connection; creates and drops scratch databases):
TEST_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
