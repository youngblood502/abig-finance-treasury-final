{
  "name": "abig-finance",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/outbox.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/worker.js",
    "start": "next start",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "testdb:init": "node ops/test-db.mjs init",
    "testdb:start": "node ops/test-db.mjs start",
    "testdb:stop": "node ops/test-db.mjs stop",
    "testdb:status": "node ops/test-db.mjs status",
    "testdb:reset": "node ops/test-db.mjs reset",
    "migrate": "node ops/migrate.mjs",
    "db:seed": "psql \"$MIGRATION_DATABASE_URL\" -f prisma/seed.sql",
    "db:demo": "psql \"$MIGRATION_DATABASE_URL\" -f prisma/demo.sql",
    "demo:passwords": "node ops/demo-passwords.mjs",
    "bootstrap:admin": "node ops/bootstrap-admin.mjs",
    "check:integrity": "psql \"$MIGRATION_DATABASE_URL\" -At -F'|' -f ops/verify-integrity.sql",
    "preview:setup": "node ops/preview-dev.mjs setup",
    "preview:dev": "node ops/preview-dev.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.69.0",
    "next": "^15.2.0",
    "nodemailer": "^10.1.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "^0.24.0",
    "prisma": "^6.0.0",
    "smtp-server": "^3.19.22",
    "tailwindcss": "4.2.4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
