# Copy to .env.production and fill in. Never commit the real file.
APP_DOMAIN=finance.example.com

# Generate each secret with:  openssl rand -base64 24   (passwords)   /   openssl rand -base64 32   (encryption key)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=
# 32 random bytes, base64. LOSING THIS LOCKS EVERYONE'S TWO-STEP SETUP; keep a copy in your password vault.
APP_ENCRYPTION_KEY=
# A different 32 random bytes, base64. Encrypts the SMTP password saved under Administration > Email; the website and the worker both get it.
# If it is lost or changed, only the SMTP password has to be entered again on that screen.
MAIL_ENCRYPTION_KEY=

# Mail for notifications, for example smtps://user:password@smtp.example.com:465
# Optional: a system administrator can set the mail server under Administration > Email instead, and those settings then take over.
SMTP_URL=
MAIL_FROM=ABIG Finance <no-reply@example.com>
