{
  "name": "abig-finance",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/outbox.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/worker.js",
    "start": "next start",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node ops/migrate.mjs",
    "db:seed": "psql \"$MIGRATION_DATABASE_URL\" -f prisma/seed.sql",
    "db:demo": "psql \"$MIGRATION_DATABASE_URL\" -f prisma/demo.sql",
    "demo:passwords": "node ops/demo-passwords.mjs",
    "bootstrap:admin": "node ops/bootstrap-admin.mjs",
    "check:integrity": "psql \"$MIGRATION_DATABASE_URL\" -At -F'|' -f ops/verify-integrity.sql"
  },
  "dependencies": {
    "next": "^15.2.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/smtp-server": "^3.5.13",
    "prisma": "^6.0.0",
    "smtp-server": "^3.19.22",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.24.0"
  }
}